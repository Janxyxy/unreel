<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/logo_tile"
                android:contentDescription="@null"
                android:src="@drawable/ic_launcher_foreground" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Service -->
        <LinearLayout
            style="@style/Row"
            android:layout_marginTop="12dp"
            android:background="@null">

            <LinearLayout style="@style/RowText">

                <TextView
                    android:id="@+id/service_status"
                    style="@style/Title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/service_hint"
                    style="@style/Summary" />
            </LinearLayout>

            <Button
                android:id="@+id/service_button"
                style="@style/PrimaryButton"
                android:text="@string/service_enable" />
        </LinearLayout>

        <!-- Blocking -->
        <TextView
            style="@style/Section"
            android:text="@string/section_blocking" />

        <LinearLayout
            android:id="@+id/row_enabled"
            style="@style/Row">

            <LinearLayout style="@style/RowText">

                <TextView
                    style="@style/Title"
                    android:text="@string/opt_enabled" />
            </LinearLayout>

            <Switch
                android:id="@+id/sw_enabled"
                style="@style/RowSwitch" />
        </LinearLayout>

        <View style="@style/Divider" />

        <LinearLayout
            android:id="@+id/row_tab"
            style="@style/Row">

            <LinearLayout style="@style/RowText">

                <TextView
                    style="@style/Title"
                    android:text="@string/opt_tab" />

                <TextView
                    style="@style/Summary"
                    android:text="@string/opt_tab_hint" />
            </LinearLayout>

            <Switch
                android:id="@+id/sw_tab"
                style="@style/RowSwitch" />
        </LinearLayout>

        <View style="@style/Divider" />

        <LinearLayout
            android:id="@+id/row_viewer"
            style="@style/Row">

            <LinearLayout style="@style/RowText">

                <TextView
                    style="@style/Title"
                    android:text="@string/opt_viewer" />

                <TextView
                    style="@style/Summary"
                    android:text="@string/opt_viewer_hint" />
            </LinearLayout>

            <Switch
                android:id="@+id/sw_viewer"
                style="@style/RowSwitch" />
        </LinearLayout>

        <View style="@style/Divider" />

        <LinearLayout
            android:id="@+id/row_dm"
            style="@style/Row">

            <LinearLayout style="@style/RowText">

                <TextView
                    style="@style/Title"
                    android:text="@string/opt_dm" />

                <TextView
                    style="@style/Summary"
                    android:text="@string/opt_dm_hint" />
            </LinearLayout>

            <Switch
                android:id="@+id/sw_dm"
                style="@style/RowSwitch" />
        </LinearLayout>

        <View style="@style/Divider" />

        <LinearLayout
            android:id="@+id/row_pause"
            style="@style/Row">

            <LinearLayout style="@style/RowText">

                <TextView
                    android:id="@+id/pause_title"
                    style="@style/Title" />

                <TextView
                    android:id="@+id/pause_status"
                    style="@style/Summary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Stats -->
        <TextView
            style="@style/Section"
            android:text="@string/section_stats" />

        <LinearLayout
            style="@style/Row"
            android:background="@null">

            <TextView
                style="@style/Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/stat_today" />

            <TextView
                android:id="@+id/stat_today"
                style="@style/Value" />
        </LinearLayout>

        <View style="@style/Divider" />

        <LinearLayout
            style="@style/Row"
            android:background="@null">

            <TextView
                style="@style/Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/stat_total" />

            <TextView
                android:id="@+id/stat_total"
                style="@style/Value" />
        </LinearLayout>

        <!-- About -->
        <TextView
            style="@style/Section"
            android:text="@string/section_about" />

        <LinearLayout
            android:id="@+id/row_github"
            style="@style/Row">

            <LinearLayout style="@style/RowText">

                <TextView
                    style="@style/Title"
                    android:text="@string/github" />

                <TextView
                    style="@style/Summary"
                    android:text="@string/github_url" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Summary"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="20dp"
            android:text="@string/restricted_hint"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
